<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="bd_pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucsal.edu.br.tutorial.login.LoginController">
   <bottom>
      <HBox alignment="CENTER" spacing="10.0">
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <Button fx:id="btn_login" mnemonicParsing="false" prefWidth="80.0" text="Login" />
         <Button fx:id="btn_exit" mnemonicParsing="false" text="Exit" />
      </HBox>
   </bottom>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets left="20.0" right="20.0" top="20.0" />
         </BorderPane.margin>
         <TextField fx:id="tf_login_name" alignment="CENTER" promptText="Login name" />
         <PasswordField fx:id="tf_password" alignment="CENTER" promptText="Password" />
         <Separator prefWidth="200.0" />
         <Label fx:id="lb_login_msg" alignment="CENTER" prefHeight="18.0" prefWidth="380.0" text="Label" visible="false" />
      </VBox>
   </center>
</BorderPane>
